{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "canvas-relay",
  "main": "src/index.ts",
  "compatibility_date": "2025-11-20",
  "routes": [{ "pattern": "canvas.paperknife.app", "custom_domain": true }],
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  // the Free plan only offers SQLite-backed Durable Objects
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "observability": { "enabled": true },
  // the website: canvas-app's build; /relay/* goes to the Worker first,
  // every other path that isn't a file gets index.html (the app routes it)
  "assets": {
    "directory": "../canvas-app/build",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/relay/*"]
  }
}
